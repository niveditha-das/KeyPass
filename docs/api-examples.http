### KeyPass API examples — runnable directly in IntelliJ's HTTP client,
### or adapt with curl. Assumes the server is running on localhost:8080.

@baseUrl = http://localhost:8080

### Register an owner
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json

{
  "email": "owner@example.com",
  "password": "password123!"
}

### Log in as the owner
# @name login
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "owner@example.com",
  "password": "password123!"
}

> {%
    client.global.set("ownerToken", response.body.accessToken);
%}

### Register a car (returns the API key once — save it)
# @name registerVehicle
POST {{baseUrl}}/api/v1/vehicles
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{
  "vin": "1HGCM82633A123456",
  "model": "KeyPass Demo Car",
  "timeZone": "Europe/Dublin"
}

> {%
    client.global.set("vehicleApiKey", response.body.apiKey);
    client.global.set("vin", response.body.vin);
%}

### List my vehicles
GET {{baseUrl}}/api/v1/vehicles
Authorization: Bearer {{ownerToken}}

### Register a device (holder's phone public key — generate one with keypass-common's Ed25519 helper)
# @name registerDevice
POST {{baseUrl}}/api/v1/devices
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{
  "publicKey": "REPLACE_WITH_BASE64_ED25519_PUBLIC_KEY",
  "label": "My phone"
}

> {%
    client.global.set("deviceId", response.body.id);
%}

### Issue a key to yourself (holderId = your own user id from /auth/login's register response)
POST {{baseUrl}}/api/v1/vehicles/{{vin}}/keys
Content-Type: application/json
Authorization: Bearer {{ownerToken}}

{
  "holderId": "REPLACE_WITH_HOLDER_USER_ID",
  "deviceId": "{{deviceId}}",
  "permissions": ["UNLOCK", "LOCK", "START_ENGINE", "SHARE"],
  "notBefore": "2026-01-01T00:00:00Z",
  "notAfter": "2026-12-31T00:00:00Z",
  "policy": [
    { "type": "CURFEW", "start": "23:00:00", "end": "06:00:00" }
  ],
  "maxSpeedKmh": 120
}

### List keys on a vehicle
GET {{baseUrl}}/api/v1/vehicles/{{vin}}/keys
Authorization: Bearer {{ownerToken}}

### Fetch the well-known server signing keys (public, no auth)
GET {{baseUrl}}/api/v1/.well-known/keypass-keys

### An access check, sent as the car (needs a real signed credential + device signature —
### see keypass-car-sim for a working end-to-end example of building this request)
POST {{baseUrl}}/api/v1/vehicles/{{vin}}/access-checks
Content-Type: application/json
X-Vehicle-Key: {{vehicleApiKey}}

{
  "credential": "REPLACE_WITH_SIGNED_CREDENTIAL",
  "command": "UNLOCK",
  "challenge": "some-random-challenge",
  "timestamp": "2026-01-15T12:00:00Z",
  "deviceSignature": "REPLACE_WITH_BASE64_DEVICE_SIGNATURE"
}

### Audit log for a vehicle
GET {{baseUrl}}/api/v1/vehicles/{{vin}}/audit
Authorization: Bearer {{ownerToken}}

### Monthly usage report
GET {{baseUrl}}/api/v1/vehicles/{{vin}}/reports/usage?month=2026-01
Authorization: Bearer {{ownerToken}}

### Alerts
GET {{baseUrl}}/api/v1/alerts
Authorization: Bearer {{ownerToken}}
