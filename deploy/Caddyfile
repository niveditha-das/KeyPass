# Caddy obtains and renews a Let's Encrypt certificate automatically for {$KEYPASS_DOMAIN}.
# KEYPASS_DOMAIN is the host or IP Caddy serves. The `shortlived` ACME profile (6-day certs, renewed
# automatically by Caddy, needs Caddy 2.11+) is required for IP-address certificates; it also works
# for hostnames.
{$KEYPASS_DOMAIN} {
	tls {
		issuer acme {
			profile shortlived
		}
	}

	encode zstd gzip

	# Prometheus scraping stays on the internal compose network; never expose it publicly.
	@internal path /actuator/*
	respond @internal 404

	reverse_proxy server:8080
}
