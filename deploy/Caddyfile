{
	# TEMPORARY: Let's Encrypt STAGING endpoint for the first deploy only. Staging has far looser
	# rate limits, so a broken config costs nothing. Its certificates are NOT browser-trusted.
	# REMOVE THIS ENTIRE GLOBAL BLOCK after the first successful issuance, then redeploy and delete
	# the caddy-data volume (or wait for renewal) so a real certificate is issued.
	acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# Caddy obtains and renews a Let's Encrypt certificate automatically for {$KEYPASS_DOMAIN}.
# KEYPASS_DOMAIN is currently a bare public IP. Let's Encrypt only issues IP-address certificates
# under the `shortlived` ACME profile (6-day certs, renewed automatically by Caddy). Needs Caddy 2.11+.
{$KEYPASS_DOMAIN} {
	tls {
		issuer acme {
			profile shortlived
		}
	}

	encode zstd gzip

	# Prometheus scraping stays on the internal compose network; never expose it publicly.
	@internal path /actuator/*
	respond @internal 404

	reverse_proxy server:8080
}
